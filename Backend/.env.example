# Copy to .env (docker compose) / export locally. Never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/chatx
DB_USERNAME=chatx
DB_PASSWORD=chatx
DB_NAME=chatx
DB_PORT=5432

PGADMIN_EMAIL=admin@chatx.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Min 256-bit secret, e.g. output of: openssl rand -base64 48
JWT_SECRET=change-me-to-a-256-bit-secret-min-32-chars-long-please
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

STORAGE_TYPE=local
# Local upload dir. On Render this is the persistent-disk mount (see render.yaml).
STORAGE_LOCAL_LOCATION=./uploads

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set true behind HTTPS (Render) so the refresh cookie is Secure + SameSite=None.
COOKIE_SECURE=false
PORT=8080
